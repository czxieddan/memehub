# syntax=docker/dockerfile:1
FROM rust:1.95-bookworm AS build
WORKDIR /build
COPY . .
RUN --mount=type=cache,id=memehub-frontend-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=memehub-frontend-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=memehub-frontend-target,target=/build/target \
    python3 memehub/scripts/frontend.py build --config frontend.toml \
      --lockfile runner.lock --locked --release --target-dir /build/target \
    && cp /build/target/release/memehub /build/memehub-bin

FROM debian:bookworm-slim
ARG SOURCE_REVISION=unknown
ARG FRONTEND_REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/czxieddan/memehub" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.licenses="LicenseRef-AHCL-1.2" \
      org.memehub.frontend.revision="${FRONTEND_REVISION}"
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home memehub \
    && mkdir -p /app/config /app/.local && chown -R memehub:memehub /app
COPY --from=build /build/memehub-bin /usr/local/bin/memehub
COPY --from=build /build/memehub/LICENSE /app/
COPY --from=build /build/memehub/.ahcl /app/.ahcl
COPY --from=build /build/frontend-materials /app/frontend
COPY --from=build /build/memehub/config/example.toml /app/config/example.toml
USER 10001:10001
WORKDIR /app
EXPOSE 7410
ENTRYPOINT ["memehub", "--config", "/app/config/local.toml"]
CMD ["serve"]
